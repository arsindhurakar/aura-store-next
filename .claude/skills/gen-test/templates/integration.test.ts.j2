import { describe, it, expect, beforeAll, afterAll, beforeEach } from 'vitest'
import request from 'supertest'
import { createApp } from '{{appImport}}'
import { createPrismaMock, type PrismaMock } from '{{testUtilsPath}}/prisma-mock'

describe('{{routeName}} API', () => {
  let app: ReturnType<typeof createApp>
  let prisma: PrismaMock
  let server: any

  beforeAll(async () => {
    prisma = createPrismaMock()
    app = createApp(prisma)
    server = app.listen(0)
  })

  afterAll(async () => {
    await server.close()
  })

  beforeEach(() => {
    vi.clearAllMocks()
  })

  describe('{{method}} {{path}}', () => {
    it('should return 200 with {{expectedResponse}}', async () => {
      // Arrange
      prisma.{{model}}.{{method}}.mockResolvedValue({{mockResponse}})

      // Act
      const response = await request(server)
        .{{methodLower}}('{{path}}')
        {% if auth %}.set('Authorization', 'Bearer {{validToken}}'){% endif %}
        {% if body %}.send({{requestBody}}){% endif %}

      // Assert
      expect(response.status).toBe(200)
      expect(response.body).toEqual({{expectedBody}})
    })

    it('should return 400 for invalid input', async () => {
      // Act
      const response = await request(server)
        .{{methodLower}}('{{path}}')
        {% if auth %}.set('Authorization', 'Bearer {{validToken}}'){% endif %}
        .send({{invalidBody}})

      // Assert
      expect(response.status).toBe(400)
      expect(response.body.success).toBe(false)
    })

    {% if auth %}
    it('should return 401 without auth', async () => {
      const response = await request(server)
        .{{methodLower}}('{{path}}')
        {% if body %}.send({{requestBody}}){% endif %}

      expect(response.status).toBe(401)
    })
    {% endif %}
  })
})